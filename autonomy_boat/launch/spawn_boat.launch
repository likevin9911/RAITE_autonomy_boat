<?xml version="1.0"?>
<launch>
  <arg name="x" default="0" />
  <arg name="y" default="0" />
  <arg name="z" default="1" />
  <arg name="yaw" default="0" />
  <arg name="joystick" default="false" />


  <include file="$(find autonomy_boat)/launch/description.launch"/>
  <include file="$(find autonomy_boat)/launch/sim/control.launch" />
  <include file="$(find autonomy_boat)/launch/sim/teleop.launch"/>
  <!-- Spawn Jackal -->
  <node name="urdf_spawner" pkg="gazebo_ros" type="spawn_model"
        args="-urdf -model jackal -param robot_description -x $(arg x) -y $(arg y) -z $(arg z) -R 0 -P 0 -Y $(arg yaw)" />
</launch>
